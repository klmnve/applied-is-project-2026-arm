# All inference stays on this machine. No API keys are needed.
DATABASE_PATH=data/audit.db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=models/multilingual-e5-small
# E5 symmetric semantic similarity: same query prefix for questions and reasons.
EMBEDDING_PREFIX="query: "
SEMANTIC_THRESHOLD=0.80
LLM_TIMEOUT_SECONDS=180
MAX_CANDIDATES=500

# Core application. No password or session secret is configured here.
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=5242880
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
SUSPICIOUS_FAILURE_THRESHOLD=3
SUSPICIOUS_WINDOW_SECONDS=600
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Comma-separated IPs/CIDRs for the immediate trusted proxy; empty ignores X-Forwarded-For.
TRUSTED_PROXIES=
# Optional institutional email policy for unverified student applications.
STUDENT_EMAIL_REQUIRED=false
STUDENT_EMAIL_DOMAIN=
