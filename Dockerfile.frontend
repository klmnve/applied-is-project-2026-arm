FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    BACKEND_URL=http://backend:8000 \
    PUBLIC_BACKEND_URL=http://localhost:8000 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /workspace
COPY requirements.frontend.txt ./requirements.frontend.txt
RUN python -m pip install --no-cache-dir -r requirements.frontend.txt \
    && groupadd --gid 10001 arm \
    && useradd --uid 10001 --gid arm --create-home arm

COPY app/__init__.py ./app/__init__.py
COPY app/frontend ./app/frontend
COPY .streamlit/config.toml ./.streamlit/config.toml
USER 10001:10001
EXPOSE 8501
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=12 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3).close()"]
CMD ["python", "-m", "streamlit", "run", "app/frontend/ui.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
